# PostgreSQL connection string for local/Render PostgreSQL.
# Example:
# DATABASE_URL=postgresql+psycopg://username:password@host:5432/database_name
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expense_tracker

# Generate a long random value for production.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
